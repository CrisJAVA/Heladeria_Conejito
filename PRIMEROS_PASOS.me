## 10. Scripts Útiles

### Backend Scripts

```bash
# Windows
cd backend/backend
.\mvnw.cmd compile          # Compilar solo código
.\mvnw.cmd test             # Ejecutar tests unitarios
.\mvnw.cmd clean            # Limpiar build
cd ..\.. && git status     # Verificar cambios

# macOS/Linux
cd backend/backend
./mvnw compile ./mvnw test ./mvnw clean
```

### Frontend Scripts

```bash
cd frontend
npm run dev        # Desarrollo con hot reload
npm run build       # Construir para producción
npm run preview     # Previsualizar build
cnpm install        # Instalar si npm no está disponible
```

### Scripts de Verificación Rápida

```bash
# Script para verificar el sistema completo (Windows)
@echo off
call :checkJava
call :checkNode
call :checkPostgreSQL
call :startBackend
call :startFrontend
call :waitForServices
call :testAPI
call :end

:checkJava
java --version
if errorlevel 1 (
    echo ERROR: Java 21+ is required
    exit /b 1
)
goto :eof

:checkNode
node --version
if errorlevel 1 (
    echo ERROR: Node.js 18+ is required
    exit /b 1
)
goto :eof

:checkPostgreSQL
psql --version
if errorlevel 1 (
    echo ERROR: PostgreSQL is required
    exit /b 1
)
goto :eof

:startBackend
cd backend\backend
start "Backend" .\mvnw.cmd spring-boot:run

:sleep 10

:startFrontend
cd frontend
start "Frontend" npm run dev

:sleep 10

:testAPI
curl -s http://localhost:8080/api/productos | find "productos" >nul
if errorlevel 1 (
    echo WARNING: Backend API no responde
)

curl -s http://localhost:5173 | find "Heladeria Conejito" >nul
if errorlevel 1 (
    echo WARNING: Frontend no responde
)

:end
echo SUCCESS: Verificación completada. ¡Sistema listo!
timeout 300
```

